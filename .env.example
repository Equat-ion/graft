# Copy to .env at the repo root and fill in real values.

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://graft:graft@localhost:5432/graft

# ---- LLM (any OpenAI-compatible endpoint) ----
# OpenAI:
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# Ollama local:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=codellama
# Together AI:   LLM_BASE_URL=https://api.together.xyz/v1
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=2048

# ---- GitHub OAuth ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:3000/oauth/github/callback
GITHUB_OAUTH_SCOPES=repo,read:org

# ---- Watcher ----
DEP_POLL_INTERVAL_MINUTES=15

# ---- Sandbox ----
SANDBOX_CPU_COUNT=2
SANDBOX_MEMORY_MB=2048
SANDBOX_TEST_TIMEOUT_SECONDS=120
BOOTSTRAP_GIT_IMAGE=alpine/git:2.47.2
BOOTSTRAP_GIT_TIMEOUT_SECONDS=180

# ---- Agent ----
AGENT_MAX_STEPS=50

# ---- Training notebooks only ----
HF_TOKEN=
TRAINING_BASE_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct
SFT_CHECKPOINT_DIR=training/checkpoints/sft
GRPO_CHECKPOINT_DIR=training/checkpoints/grpo
